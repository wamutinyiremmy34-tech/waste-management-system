# EcoTrack backend environment configuration
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# --- App ---
APP_NAME=EcoTrack
# Valid values: development | testing | production
# In production, startup validation will refuse to start if SECRET_KEY is
# the default, and docs_url/redoc_url will be disabled automatically.
APP_ENV=development
# DEBUG must be False in production — True can expose stack traces in responses.
DEBUG=false

# --- Security ---
# REQUIRED: Generate a real secret before any non-local deployment:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# The application will refuse to start in production/staging with this default.
SECRET_KEY=CHANGE_ME_INSECURE_DEV_ONLY_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Database (PostgreSQL + PostGIS) ---
# This default connects as the `ecotrack` superuser — convenient for local
# development and migrations. For real Row-Level Security enforcement (see
# docs/multi-tenancy.md), the application should connect as the restricted
# `ecotrack_app` role instead. Migrations must keep using the superuser.
#
# After running migrations in any non-dev environment, change the
# ecotrack_app role password:
#   psql -U ecotrack -c "ALTER ROLE ecotrack_app PASSWORD 'your-secure-password';"
# Then set DATABASE_URL below to use ecotrack_app for the app process.
DATABASE_URL=postgresql+psycopg2://ecotrack:ecotrack_dev_pw@localhost:5432/ecotrack_dev

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
# Comma-separated list of allowed origins. In production, set this to the
# exact domain(s) serving your frontend — never leave as localhost.
CORS_ORIGINS=["http://localhost:3000"]

# --- File storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads
MAX_UPLOAD_SIZE_MB=8

# --- Seeding ---
# NEVER set to true in production — seed.py creates demo accounts with
# known credentials. Use only for local development or CI.
# To seed manually: python3 scripts/seed.py
SEED_ON_START=false

# --- Spatial intelligence ---
# Radius in metres used to find nearby complaints/bins when scoring pickups.
# Increase for rural/spread-out areas; decrease for dense urban areas.
NEARBY_RADIUS_METERS=500
