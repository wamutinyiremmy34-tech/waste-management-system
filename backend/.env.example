# --- App ---
APP_NAME=EcoTrack
APP_ENV=development
DEBUG=true

# --- Security ---
# Generate a real secret for anything beyond local dev, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_INSECURE_DEV_ONLY_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Database (PostgreSQL + PostGIS) ---
# This default connects as the `ecotrack` superuser, used for migrations and
# local development convenience. For real defense-in-depth from the Row-Level
# Security policies described in docs/multi-tenancy.md, point this at the
# restricted `ecotrack_app` role instead (created by the RLS migration) —
# Postgres superusers bypass RLS unconditionally, so the app must NOT connect
# as `ecotrack` for RLS to actually protect anything:
#   DATABASE_URL=postgresql+psycopg2://ecotrack_app:ecotrack_app_dev_pw@localhost:5432/ecotrack_dev
# Migrations and scripts/seed.py should keep using the `ecotrack` superuser
# connection regardless, since they need DDL/broader privileges.
DATABASE_URL=postgresql+psycopg2://ecotrack:ecotrack_dev_pw@localhost:5432/ecotrack_dev

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (comma-separated JSON list is NOT used — pydantic-settings parses this as a list) ---
CORS_ORIGINS=["http://localhost:3000"]

# --- File storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads
MAX_UPLOAD_SIZE_MB=8

# --- Seeding (Docker entrypoint only) ---
SEED_ON_START=false
